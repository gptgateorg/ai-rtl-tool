{
  "manifest_version": 3,
  "name": "GptGate",
  "version": "0.1.1",
  "description": "فارسی روان‌تر در ChatGPT، Gemini و Claude؛ تنظیم جهت و فونت، و خروجی PDF و Word از ChatGPT.",
  "icons": {
    "16": "images/logo.png",
    "48": "images/logo.png",
    "128": "images/logo.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/chatgpt/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/gemini/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/claude/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GptGate",
    "default_icon": {
      "16": "images/logo.png",
      "48": "images/logo.png",
      "128": "images/logo.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/core.js",
        "src/shared/constants.js",
        "src/chatgpt/selectors.js",
        "src/gemini/selectors.js",
        "src/claude/selectors.js",
        "images/logo.png",
        "images/floating-logo.png",
        "fonts/*",
        "src/shared/fonts.js",
        "src/shared/export-content.js",
        "src/chatgpt/pdf-export.js",
        "fonts/licenses/*",
        "images/brand-mark.svg",
        "src/shared/tips.js"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ]
    }
  ]
}
